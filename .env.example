# Copy this file to .env at the repository root, then fill in your local values.
# Only VITE_* variables are exposed to the browser. Keep API keys backend-only.
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://localhost:5065

Gemini__BaseUrl=https://generativelanguage.googleapis.com/
Gemini__Model=gemini-3.8-flash
# Fallback models (comma separated) tried in order when the model above is rate limited (429),
# overloaded (5xx), unknown (404) or slower than Gemini__FallbackAfterSeconds (default 30 s for
# grading/transcription, 90 s for question generation). Default: gemini-3.5-flash-lite.
# Gemini__FallbackModels=gemini-3.5-flash-lite
# Gemini__FallbackAfterSeconds=30
# Embedding model used to index study documents for RAG question generation.
Gemini__EmbeddingModel=gemini-embedding-001
GEMINI_API_KEY=

# Optional: use this instead of setting the connection string in PowerShell.
# ConnectionStrings__QuestionBank="Host=localhost;Port=5432;Database=aives;Username=aives;Password=YOUR_POSTGRES_PASSWORD"
# Optional, for start-dev.cmd: a Docker container that serves the database above when it is not
# backend/compose.postgres.yml (port 5432). start-dev starts it when the database is not reachable.
# AIVES_DB_CONTAINER=aives-demo-pg
